{
  "name": "argentum-web-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "maps:build": "cd ../server && mix run --no-start scripts/build_map_pack.exs",
    "generate:npc-raw-bodies": "node scripts/generateNpcRawBodies.mjs",
    "predev": "npm run maps:build",
    "prebuild": "npm run maps:build",
    "prepreview": "npm run maps:build",
    "dev": "vite",
    "dev:ui": "vite --mode test-ui --host 127.0.0.1 --port 4173 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "pixi.js": "^7.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright": "^1.59.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^4.1.4"
  }
}
